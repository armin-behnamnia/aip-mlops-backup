# Required on the MLOps platform
BEARER_TOKEN=replace_me

# The dataset is pulled from the platform data registry by default.
# TRAIN_FILE/TEST_FILE are auto-detected (train*/test*) inside the download.
DATASET_NAME=CHANGE_ME_DATASET
BASE_MODEL_NAME=CHANGE_ME_MODEL
SAVE_MODEL_NAME=dadmatools_toolcall_lora

# Optional local paths; each skips the corresponding registry download.
# DATASET_DIR=/absolute/path/to/dataset_folder
# BASE_MODEL_DIR=/absolute/path/to/model
# TRAIN_FILE=dadmatools_trainset_new.json
# TEST_FILE=dadmatools_testset_new.json

# Which adapter runs to train: auto (default; single run decided by dataset
# reasoning traces + chat-template support), true, false, or both.
THINKING_MODES=auto

# Training defaults follow the platform doc: 1 epoch, batch 2, grad-accum 4,
# adamw_8bit, lr 10e-5. Uncomment to override.
# EPOCHS=1
# BATCH_SIZE=2
# GRAD_ACCUM=4
# OPTIM=adamw_8bit

# Inference/data controls
MAX_SEQ_LENGTH=2048
MAX_NEW_TOKENS=512
# Recommended: cap test-set inference (4 time-points are evaluated per run).
MAX_TEST_SAMPLES=100

# Full first two + final decoder layers (requested). Use first2 if memory is
# tight, or none + LOAD_IN_4BIT=1 for pure QLoRA.
EXTRA_UNFROZEN_MODE=first2_last
LOAD_IN_4BIT=0
