# این فایل را به نام .env کپی کنید و مقادیر را پر کنید.
# .env در .gitignore است و نباید در گیت کامیت شود.

# توکن پلتفرم — از «عملیات یادگیری ماشین > کلید اپلیکیشن»
BEARER_TOKEN=

# نام دیتاست در رجیستری داده (الزامی)
DATASET_NAME=

# نام مدل پایه در رجیستری مدل (الزامی)
BASE_MODEL_NAME=

# نام مدل خروجی در رجیستری مدل (اختیاری؛ پیش‌فرض dadmatech_finetuned)
OUTPUT_MODEL_NAME=dadmatech_finetuned
